{
  "name": "sloth-digest",
  "version": "1.0.0",
  "description": "Private overnight Gmail digest using Gemma on llama.cpp, Mastra, and Temporal",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "worker": "tsx src/temporal/worker.ts",
    "workflow": "tsx src/cli.ts run",
    "schedule": "tsx src/cli.ts schedule",
    "serve": "tsx src/deliver/server.ts",
    "seed": "tsx scripts/seed-gmail.ts",
    "sloth": "tsx src/cli.ts",
    "test-pipeline": "tsx src/test-local.ts"
  },
  "keywords": [
    "hacktoberfest",
    "gemma",
    "temporal",
    "mastra",
    "llamacpp",
    "email-digest",
    "privacy-first"
  ],
  "author": "pbkhang404",
  "license": "MIT",
  "dependencies": {
    "@mastra/core": "^1.79.0",
    "@temporalio/activity": "^1.24.0",
    "@temporalio/client": "^1.24.0",
    "@temporalio/worker": "^1.24.0",
    "@temporalio/workflow": "^1.24.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.9",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/html-to-text": "^9.0.4",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
